# Copy to server/.env and fill in. The API loads it automatically.

# Postgres. Defaults to the docker-compose database on port 5433, so this is
# only needed if you point Sundial somewhere else.
# DATABASE_URL=postgres://sundial:sundial_dev@localhost:5433/sundial

# Events tab. Free, self-serve, no credit card:
#   https://developer-acct.ticketmaster.com/user/register
# Copy the "Consumer Key" here. Without it the Events tab explains how to add one.
TICKETMASTER_API_KEY=
