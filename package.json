{
  "name": "adonis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @adonis/server dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @adonis/server migrate",
    "db:psql": "docker exec -it adonis-postgres psql -U adonis -d adonis",
    "setup": "pnpm install && pnpm db:up && pnpm db:migrate",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "type-check": "tsc -b && pnpm --filter @adonis/server type-check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run && pnpm --filter @adonis/server test",
    "warm": "pnpm --filter @adonis/server warm",
    "warm:photos": "pnpm --filter @adonis/server warm:photos",
    "warm:photos:remote": "bash server/scripts/warm-photos-remote.sh"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
